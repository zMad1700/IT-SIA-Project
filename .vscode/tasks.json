{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Vite development server",
            "type": "process",
            "command": "npm.cmd",
            "args": ["run", "dev"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v",
                    "endsPattern": "Local:\\s+http://localhost:8080/"
                }
            }
        }
    ]
}
